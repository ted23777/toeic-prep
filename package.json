{
  "name": "toeic-prep",
  "version": "1.0.0",
  "description": "Application web statique de révision du TOEIC Listening & Reading, sans compte ni collecte de données.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "python3 -m http.server 8000 --bind 127.0.0.1 --directory site",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0"
  }
}
